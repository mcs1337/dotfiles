// ~/.config/fastfetch/config.jsonc
// Tokyo Night fastfetch config, sized for a ~100x30 terminal.
// Needs a Nerd Font for the icons. Tested against fastfetch 2.40.x options.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "color": { "1": "38;2;122;162;247", "2": "38;2;187;154;247" },
    "padding": { "top": 3, "left": 3, "right": 5 }
  },

  "display": {
    "separator": "  ",
    "percent": { "type": 3 },   // bar + number for RAM, swap, disk
    "color": {
      "keys": "38;2;122;162;247",   // blue
      "title": "38;2;187;154;247",  // purple
      "output": "38;2;169;177;214"  // soft white
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;187;154;247",
        "at": "38;2;86;95;137",
        "host": "38;2;125;207;255"
      }
    },
    { "type": "separator", "string": "─", "outputColor": "38;2;86;95;137" },

    // System
    { "type": "os",       "key": " OS      " },
    { "type": "host",     "key": "󰌢 Host    " },
    { "type": "kernel",   "key": " Kernel  " },
    { "type": "uptime",   "key": " Uptime  " },
    { "type": "packages", "key": " Pkgs    " },
    { "type": "shell",    "key": " Shell   " },

    "break",

    // Desktop
    { "type": "de",       "key": " DE      " },
    { "type": "wm",       "key": " WM      " },
    { "type": "theme",    "key": "󰏘 Theme   " },
    { "type": "icons",    "key": "󰀻 Icons   " },
    { "type": "font",     "key": " Font    " },
    { "type": "terminal", "key": " Term    " },

    "break",

    // Hardware
    { "type": "cpu",     "key": " CPU     " },
    { "type": "gpu",     "key": "󰢮 GPU     " },
    { "type": "display", "key": "󰍹 Display " },
    { "type": "memory",  "key": "󰍛 RAM     " },
    { "type": "swap",    "key": "󰓡 Swap    " },
    { "type": "disk",    "key": "󰋊 Disk    ", "folders": "/" },

    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
