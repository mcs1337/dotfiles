// ~/.config/fastfetch/config.jsonc
// Minimal Tokyo Night fastfetch config (matches the Neovim and tmux themes)
// Needs a Nerd Font for the icons.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "color": { "1": "38;2;122;162;247", "2": "38;2;187;154;247" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;122;162;247",   // blue
      "title": "38;2;187;154;247",  // purple
      "output": "38;2;169;177;214"  // soft white
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;187;154;247",
        "at": "38;2;86;95;137",
        "host": "38;2;125;207;255"
      }
    },
    { "type": "separator", "string": "─", "outputColor": "38;2;86;95;137" },

    { "type": "os",       "key": " OS    " },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "uptime",   "key": " Uptime" },
    { "type": "packages", "key": " Pkgs  " },
    { "type": "shell",    "key": " Shell " },
    { "type": "terminal", "key": " Term  " },
    { "type": "de",       "key": " DE    " },

    "break",

    { "type": "cpu",    "key": " CPU   " },
    { "type": "gpu",    "key": "󰢮 GPU   " },
    { "type": "memory", "key": "󰍛 RAM   " },
    { "type": "disk",   "key": "󰋊 Disk  ", "folders": "/" },

    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
