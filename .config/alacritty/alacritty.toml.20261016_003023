[window]
dimensions = { columns = 100, lines = 30 }
padding = { x = 4, y = 4 }
dynamic_padding = true
opacity = 0.8
blur = true
resize_increments = true

[font]
normal = { family = "IosevkaTermSlab Nerd Font", style = "Regular" }
bold = { family = "IosevkaTermSlab Nerd Font", style = "Bold" }
size = 13.0

[cursor]
style = { shape = "Block", blinking = "On" }
